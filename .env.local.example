# Resend API key — get one free at https://resend.com (server-side only).
# Without it, the contact form gracefully falls back to a mailto link.
RESEND_API_KEY=

# URL publique du site (metadata, sitemap). Sur Vercel : https://<projet>.vercel.app ou le domaine final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
